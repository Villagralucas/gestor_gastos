# Copiá este archivo como `.env.local` y completá los valores.
# Los saca del panel de Supabase, en Project Settings > API Keys.
#
# La "publishable key" (sb_publishable_...) es la unica que puede estar en el
# navegador. La "secret key" no va aca ni en ningun archivo del repo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
